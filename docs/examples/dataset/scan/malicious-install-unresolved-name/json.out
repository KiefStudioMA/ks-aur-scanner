      "id": "ATOMIC-002",
      "severity": "critical",
      "category": "malicious_code",
      "title": "Node/Bun package manager in install hook (install script)",
      "description": "Invokes npm/pnpm/yarn/bun (or the npx/bunx runners) to install or run packages from an install hook. The June 2026 'Atomic Arch' campaign added post-install hooks running `npm install atomic-lockfile` / `bun install js-digest`. Legitimate packages never fetch or execute npm/bun packages during the install phase. `npm ci`, `npm rebuild`, `npm exec`, `pnpm dlx`, `yarn dlx`, and the bare `npx <pkg>` / `bunx <pkg>` runners all fetch-and-run lifecycle/remote code just like `install`.",
      "location": {
        "file": "tests/fixtures/malicious/install-unresolved-name/demo.scr",
        "line": 2,
        "column": 3,
        "snippet": "  npm install evilpkg"
      },
      "recommendation": "Install scripts must never fetch or install npm/bun packages. Inspect the PKGBUILD diff and report the package to the AUR maintainers.",
      "cwe_id": "CWE-494",
      "metadata": {
        "in_install_script": true,
        "matched_text": "npm install",
        "script_kind": "install script"
      }
    },
    {
      "id": "META-007",
      "severity": "high",
      "category": "suspicious_metadata",
      "title": "install= cannot be statically resolved",
      "description": "The install scriptlet name is not a plain value the scanner can resolve (install modified by += / [i]= / read / printf -v). makepkg runs whichever file it names as the package's install scriptlet, so every file beside the PKGBUILD was scanned as a possible scriptlet.",
      "location": {
        "file": "tests/fixtures/malicious/install-unresolved-name/PKGBUILD",
        "line": null,
        "column": null,
        "snippet": "install=install modified by += / [i]= / read / printf -v"
      },
      "recommendation": "Do not install. Use a literal `install=<pkgname>.install` and review the file it names.",
      "cwe_id": "CWE-426",
