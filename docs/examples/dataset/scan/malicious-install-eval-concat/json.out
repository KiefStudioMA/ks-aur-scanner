    {
      "id": "ATOMIC-005",
      "severity": "medium",
      "category": "malicious_code",
      "title": "Named npm/bun package fetched during the build (source sidecar)",
      "description": "A PKGBUILD function runs `npm/pnpm/yarn/bun install|add <package>` for an explicit package name. The package is fetched from the registry during the build, outside source= and its checksums, and runs its lifecycle scripts. The June 2026 'Atomic Arch' campaign added exactly this to build(). A bare `npm install`, `npm ci` or an install from a local tarball is not reported.",
      "location": {
        "file": "tests/fixtures/malicious/install-eval-concat/demo.scr",
        "line": 2,
        "column": 1,
        "snippet": "  npm install -g evilpkg"
      },
      "recommendation": "Vendor the dependency through source= with a checksum (or a lockfile shipped in the tarball) instead of naming a registry package in build().",
      "cwe_id": "CWE-494",
