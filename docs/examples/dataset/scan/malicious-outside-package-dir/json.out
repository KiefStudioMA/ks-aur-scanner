    {
      "id": "SRC-011",
      "severity": "high",
      "category": "configuration",
      "title": "References files outside the package directory",
      "description": "A PKGBUILD or scriptlet reaches above the package directory through $startdir/.., $BUILDDIR/.. or $srcdir/../.. (srcdir is startdir/src, so two levels). Whatever sits there, such as a sibling package in an AUR helper's build cache, is code the scanner never saw, and the package can read it, source it or run it. Their contents were not reviewed.",
      "location": {
        "file": "tests/fixtures/malicious/outside-package-dir/PKGBUILD",
        "line": 13,
        "column": 11,
        "snippet": "    bash \"$srcdir/../../sibling-pkg/helper.sh\""
      },
      "recommendation": "Do not build. A package must only use files it ships in its own directory; put anything else in source= with a checksum.",
      "cwe_id": "CWE-22",
      "metadata": {
        "matched_text": "$srcdir/../../"
