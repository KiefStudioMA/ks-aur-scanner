        "line": null,
        "column": null,
        "snippet": "url=https://github.com/vlaci/openconnect-sso  source=git+https://github.com/PrestonHager/openconnect-sso.git"
      },
      "recommendation": "Confirm 'prestonhager' is an official mirror of 'vlaci/openconnect-sso'. If it is not, this package builds code the upstream project did not publish.",
      "cwe_id": "CWE-494",
      "metadata": {
        "actual_owner": "prestonhager",
        "actual_source": "github.com/prestonhager/openconnect-sso",
        "declared_owner": "vlaci",
