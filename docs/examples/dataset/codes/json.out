{
  "entries": [
    {
      "id": "ATOMIC-001",
      "name": "Atomic Arch malicious npm/bun package",
      "severity": "critical",
      "category": "malicious_code",
      "description": "References a known-malicious package from the June 2026 'Atomic Arch' AUR supply-chain campaign (atomic-lockfile, js-digest, lockfile-js, nextfile-js / ansi-colors-nextfile-js and related wave-3 names). These pull an infostealer and eBPF rootkit during the build/install phase.",
      "recommendation": "Do NOT build. This is a known-malicious dependency. Remove the package and treat the host as compromised: rotate credentials (SSH, npm/GitHub tokens, browser sessions).",
      "cwe": "CWE-506",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "ATOMIC-002",
      "name": "Node/Bun package manager in install hook",
      "severity": "critical",
      "category": "malicious_code",
      "description": "Invokes npm/pnpm/yarn/bun (or the npx/bunx runners) to install or run packages from an install hook. The June 2026 'Atomic Arch' campaign added post-install hooks running `npm install atomic-lockfile` / `bun install js-digest`. Legitimate packages never fetch or execute npm/bun packages during the install phase. `npm ci`, `npm rebuild`, `npm exec`, `pnpm dlx`, `yarn dlx`, and the bare `npx <pkg>` / `bunx <pkg>` runners all fetch-and-run lifecycle/remote code just like `install`.",
      "recommendation": "Install scripts must never fetch or install npm/bun packages. Inspect the PKGBUILD diff and report the package to the AUR maintainers.",
      "cwe": "CWE-494",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "ATOMIC-003",
      "name": "eBPF rootkit / payload artifact",
      "severity": "critical",
      "category": "persistence",
      "description": "References the eBPF rootkit object (scales.bpf.c) or the 'deps' hook path used by the June 2026 'Atomic Arch' payload to gain rootkit-like capabilities and hide itself.",
      "recommendation": "This is a rootkit dropper artifact. Do not build; treat the host as compromised and reinstall rather than clean.",
      "cwe": "CWE-506",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "ATOMIC-004",
      "name": "Sudo shim in user local bin",
      "severity": "critical",
      "category": "malicious_code",
      "description": "Writes a `sudo` binary (or symlink) into `~/.local/bin` or another user PATH prefix. The Atomic Arch campaign dropped a credential-stealing sudo shim this way so a later `sudo` invocation harvested the password.",
      "recommendation": "Do NOT build. A package must never install a sudo impostor. Inspect ~/.local/bin/sudo and rotate credentials if present.",
      "cwe": "CWE-506",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "ATOMIC-005",
      "name": "Named npm/bun package fetched during the build",
      "severity": "medium",
      "category": "malicious_code",
      "description": "A PKGBUILD function runs `npm/pnpm/yarn/bun install|add <package>` for an explicit package name. The package is fetched from the registry during the build, outside source= and its checksums, and runs its lifecycle scripts. The June 2026 'Atomic Arch' campaign added exactly this to build(). A bare `npm install`, `npm ci` or an install from a local tarball is not reported.",
      "recommendation": "Vendor the dependency through source= with a checksum (or a lockfile shipped in the tarball) instead of naming a registry package in build().",
      "cwe": "CWE-494",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "ATOMIC-006",
      "name": "npm/bun package installed from a URL or git remote during the build",
      "severity": "high",
      "category": "malicious_code",
      "description": "A PKGBUILD function installs a package straight from a URL, git remote or forge shorthand (`npm install git+https://...`, `github:user/repo`). Nothing pins or checksums that code, and it runs its lifecycle scripts as the builder.",
      "recommendation": "Do not build. Fetch the code through source= with a checksum.",
      "cwe": "CWE-494",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "ATOMIC-007",
      "name": "npx/exec/bunx runs a package by name during the build",
      "severity": "low",
      "category": "malicious_code",
      "description": "A PKGBUILD function runs `npx <name>`, `bunx <name>`, `pnpm exec <name>` or similar. These run a local tool when one is installed and otherwise fetch the package from the registry and run it, so a legitimate build step (`npx tsc`) and the Atomic Arch shape (`npx evilpkg`) look the same. Reported at Low so it can be reviewed without drowning the stronger findings; `npx -y`, `dlx` and named installs are ATOMIC-005.",
      "recommendation": "Make sure the tool is a declared devDependency installed from a lockfile, not fetched at build time.",
      "cwe": "CWE-494",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "BIN-001",
      "name": "Prebuilt binary committed in the package directory",
      "severity": "high",
      "category": "suspicious_metadata",
      "description": "An executable ships inside the package directory rather than being fetched from a declared source. An AUR repository holds a build recipe; a compiled artifact in it has no upstream anyone can review. High when nothing in the PKGBUILD references it, Medium when package() installs it.",
      "recommendation": "Confirm why a compiled artifact ships with the build recipe, and where it came from.",
      "cwe": "CWE-494",
      "owner": "binary",
      "pattern_based": false
    },
    {
      "id": "BIN-002",
      "name": "Prebuilt binary executed during the build",
      "severity": "critical",
      "category": "malicious_code",
      "description": "A build function runs an executable that was committed alongside the PKGBUILD. Building should compile source, not run an opaque binary that arrived with the recipe -- the shape reported in issue #29 (openconnect-sso).",
      "recommendation": "Do not build. A build step that runs a bundled binary is running unreviewed code.",
      "cwe": "CWE-506",
      "owner": "binary",
      "pattern_based": false
    },
    {
      "id": "BIN-003",
      "name": "Prebuilt eBPF object",
      "severity": "critical",
      "category": "malicious_code",
      "description": "An eBPF object ships as a compiled blob. eBPF runs in the KERNEL, and this one has no source to read. The June 2026 Atomic Arch campaign delivered an eBPF rootkit through AUR packages this way.",
      "recommendation": "Do not install; obtain the eBPF source and build it.",
      "cwe": "CWE-506",
      "owner": "binary",
      "pattern_based": false
    },
    {
      "id": "BIN-004",
      "name": "Binary searches for libraries in an unsafe location",
      "severity": "high",
      "category": "privilege_escalation",
      "description": "A DT_RPATH/DT_RUNPATH points somewhere world-writable, resolves against the working directory, or climbs out of the install tree. A library placed there is loaded in preference to the system copy.",
      "recommendation": "Do not install a binary whose library search path others can write.",
      "cwe": "CWE-426",
      "owner": "binary",
      "pattern_based": false
    },
    {
      "id": "BIN-005",
      "name": "Binary contains a packed or encrypted section",
      "severity": "medium",
      "category": "obfuscation",
      "description": "A section measures over 7.5 bits/byte of entropy. Ordinary compiled code measures 6.0-6.9 and compressed data ~8.0, so content this dense is packed or encrypted and cannot be statically reviewed.",
      "recommendation": "Treat a packed binary in a source package as unreviewable.",
      "cwe": "CWE-506",
      "owner": "binary",
      "pattern_based": false
    },
    {
      "id": "BROWSER-001",
      "name": "Browser profile access",
      "severity": "critical",
      "category": "credential_theft",
      "description": "Accessing browser profiles may indicate credential theft",
      "recommendation": "Package should never access browser profiles",
      "cwe": "CWE-522",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "BROWSER-002",
      "name": "Browser database access",
      "severity": "critical",
      "category": "credential_theft",
      "description": "Accessing browser SQLite databases (passwords, cookies, history)",
      "recommendation": "Package should never access browser databases",
      "cwe": "CWE-522",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "CHK-001",
      "name": "No checksums for sources",
      "severity": "high",
      "category": "cryptography",
      "description": "Package sources have no checksum verification.",
      "recommendation": "Provide sha256sums or stronger for every source.",
      "cwe": "CWE-354",
      "owner": "checksum",
      "pattern_based": false
    },
    {
      "id": "CHK-002",
      "name": "MD5 checksums used",
      "severity": "medium",
      "category": "cryptography",
      "description": "MD5 is cryptographically broken.",
      "recommendation": "Replace md5sums with sha256sums or sha512sums.",
      "cwe": "CWE-328",
      "owner": "checksum",
      "pattern_based": false
    },
    {
      "id": "CHK-003",
      "name": "SHA1 checksums used",
      "severity": "medium",
      "category": "cryptography",
      "description": "SHA1 is cryptographically weak.",
      "recommendation": "Replace sha1sums with sha256sums or sha512sums.",
      "cwe": "CWE-328",
      "owner": "checksum",
      "pattern_based": false
    },
    {
      "id": "CHK-004",
      "name": "Some sources use SKIP checksum",
      "severity": "medium",
      "category": "cryptography",
      "description": "Some non-VCS sources skip integrity verification.",
      "recommendation": "Provide real checksums for non-VCS sources.",
      "cwe": "CWE-354",
      "owner": "checksum",
      "pattern_based": false
    },
    {
      "id": "CHK-005",
      "name": "All non-VCS sources use SKIP",
      "severity": "high",
      "category": "cryptography",
      "description": "No integrity verification is performed on any non-VCS source.",
      "recommendation": "Provide real checksums for non-VCS sources.",
      "cwe": "CWE-354",
      "owner": "checksum",
      "pattern_based": false
    },
    {
      "id": "CHK-006",
      "name": "Checksum count mismatch",
      "severity": "high",
      "category": "configuration",
      "description": "The number of checksums does not match the number of sources.",
      "recommendation": "Align the checksum array with the source array.",
      "cwe": null,
      "owner": "checksum",
      "pattern_based": false
    },
    {
      "id": "CHK-008",
      "name": "Malformed or wrong-length checksum",
      "severity": "medium",
      "category": "cryptography",
      "description": "A checksum is not valid hex of the algorithm's expected length (md5=32, sha1=40, sha256=64, sha512/b2=128).",
      "recommendation": "Regenerate checksums with updpkgsums; a malformed hash silently disables integrity verification.",
      "cwe": "CWE-354",
      "owner": "checksum",
      "pattern_based": false
    },
    {
      "id": "CHK-009",
      "name": "Checksum alignment cannot be determined",
      "severity": "medium",
      "category": "cryptography",
      "description": "An element of source=() or a checksum array cannot be counted statically (unquoted command substitution or variable, whole-array expansion, or an oversized brace list), so sources from that position on cannot be matched to their checksums. Positions before it are still checked.",
      "recommendation": "Write source= and the checksum arrays as plain literal lists.",
      "cwe": "CWE-354",
      "owner": "checksum",
      "pattern_based": false
    },
    {
      "id": "CRED-001",
      "name": "SSH key access",
      "severity": "critical",
      "category": "credential_theft",
      "description": "Accessing SSH private keys during build/install",
      "recommendation": "Package should never access user SSH keys",
      "cwe": "CWE-522",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "CRED-002",
      "name": "GPG key access",
      "severity": "critical",
      "category": "credential_theft",
      "description": "Accessing GPG keyring during build/install",
      "recommendation": "Package should never access user GPG keys",
      "cwe": "CWE-522",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "CRED-003",
      "name": "Password file access",
      "severity": "critical",
      "category": "credential_theft",
      "description": "Accessing password files or credential stores",
      "recommendation": "Package should never access credential stores",
      "cwe": "CWE-522",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "CRED-004",
      "name": "Cloud / CI credential file access",
      "severity": "high",
      "category": "credential_theft",
      "description": "Reads cloud or CI credential files (gcloud, docker config, npmrc, pypirc, cargo/terraform credentials, git-credentials).",
      "recommendation": "Verify why a build/install touches credential files.",
      "cwe": "CWE-522",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "CRED-005",
      "name": "Keyring / wallet access",
      "severity": "critical",
      "category": "credential_theft",
      "description": "Reads OS keyrings (gnome-keyring/kwallet/secret-tool) or crypto wallet files (electrum/bitcoin/metamask/keystore).",
      "recommendation": "Do not build. This harvests secrets/wallets.",
      "cwe": "CWE-522",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "CRED-008",
      "name": "Environment/secret dump",
      "severity": "high",
      "category": "credential_theft",
      "description": "Dumping the environment (env/printenv) to a file or pipe to curl/nc/base64 — harvests tokens and secrets exposed as env vars.",
      "recommendation": "Remove. Packages have no reason to dump the environment.",
      "cwe": "CWE-522",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "CRYPTO-001",
      "name": "Mining pool connection",
      "severity": "critical",
      "category": "cryptomining",
      "description": "Connection to cryptocurrency mining pools",
      "recommendation": "Remove cryptomining components",
      "cwe": "CWE-506",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "CRYPTO-002",
      "name": "Cryptominer binary",
      "severity": "critical",
      "category": "cryptomining",
      "description": "Known cryptocurrency miner executable names",
      "recommendation": "Remove cryptomining components",
      "cwe": "CWE-506",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "CRYPTO-003",
      "name": "Monero/Bitcoin wallet address",
      "severity": "critical",
      "category": "cryptomining",
      "description": "Cryptocurrency wallet addresses indicate mining or theft",
      "recommendation": "Wallet addresses in packages are highly suspicious",
      "cwe": "CWE-506",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "DEEP-001",
      "name": "Decode-and-execute flow",
      "severity": "critical",
      "category": "obfuscation",
      "description": "The file decodes/decompresses data and dynamically executes shell input, possibly across lines.",
      "recommendation": "Decode and review the payload manually.",
      "cwe": "CWE-506",
      "owner": "deep",
      "pattern_based": false
    },
    {
      "id": "DEEP-002",
      "name": "Large embedded encoded blob",
      "severity": "high",
      "category": "obfuscation",
      "description": "A large base64-like blob is embedded in the package.",
      "recommendation": "Decode and verify the blob is legitimate data.",
      "cwe": "CWE-506",
      "owner": "deep",
      "pattern_based": false
    },
    {
      "id": "DEEP-003",
      "name": "Unicode bidirectional control characters",
      "severity": "critical",
      "category": "obfuscation",
      "description": "Bidi control characters reorder how text DISPLAYS without changing what executes, so a reviewer can read different code than makepkg runs (Trojan Source, CVE-2021-42574). Shell source has no legitimate use for an explicit directional override.",
      "recommendation": "Strip the bidi characters and re-read the file before trusting any review of it.",
      "cwe": "CWE-94",
      "owner": "deep",
      "pattern_based": false
    },
    {
      "id": "DEP-001",
      "name": "Provides a core package name (dependency confusion)",
      "severity": "high",
      "category": "suspicious_metadata",
      "description": "provides= a curated core package name from a package that is not that package's own alternate, satisfying a dependency in its place.",
      "recommendation": "Remove the provides unless this is the legitimate provider.",
      "cwe": "CWE-427",
      "owner": "metadata",
      "pattern_based": false
    },
    {
      "id": "DEP-003",
      "name": "Package index/registry override",
      "severity": "high",
      "category": "dependencies",
      "description": "Redirects a language package manager to a non-default index/registry (pip --index-url, npm registry, GOPROXY, etc.) — a dependency-confusion vector.",
      "recommendation": "Verify the index host; overriding the registry redirects dependencies to an attacker source.",
      "cwe": "CWE-494",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "DIFF-001",
      "name": "New findings since the last scan",
      "severity": "high",
      "category": "suspicious_metadata",
      "description": "The package raised findings it did not raise when it was last scanned. Reported at the severity of the worst NEW finding: a long-standing SKIP checksum is not news, a newly-appeared curl|sh is. Silent on a first scan.",
      "recommendation": "Review the new findings specifically -- they are what changed since you approved this package.",
      "cwe": null,
      "owner": "diff",
      "pattern_based": false
    },
    {
      "id": "DIFF-002",
      "name": "Package ownership changed",
      "severity": "high",
      "category": "suspicious_metadata",
      "description": "The maintainer changed since the last scan. Adoption of a previously orphaned package is High and is the documented mechanism of both the 2018 xeactor hijack and the 2026 Atomic Arch campaign; an ordinary handover, or a package becoming orphaned, is Medium.",
      "recommendation": "Confirm the handover is legitimate before installing an update.",
      "cwe": null,
      "owner": "diff",
      "pattern_based": false
    },
    {
      "id": "DIFF-003",
      "name": "Package fetches from a new upstream",
      "severity": "high",
      "category": "network_security",
      "description": "A source now points at a host/owner/repo it did not use at the last scan. Compared at owner/repo depth, so routine version bumps and new release tarballs do not fire -- upstream itself moved.",
      "recommendation": "Verify the new upstream is the project's real home and not a fork impersonating it.",
      "cwe": "CWE-494",
      "owner": "diff",
      "pattern_based": false
    },
    {
      "id": "DIFF-004",
      "name": "Install script added or changed",
      "severity": "high",
      "category": "persistence",
      "description": "The package gained an install scriptlet or ALPM hook (High), or an existing one changed (Medium). This code runs as root at install time, so acquiring one changes what the package can do to the system regardless of its current contents.",
      "recommendation": "Read the new or changed install script in full before installing.",
      "cwe": "CWE-506",
      "owner": "diff",
      "pattern_based": false
    },
    {
      "id": "DLE-001",
      "name": "Curl pipe to shell",
      "severity": "critical",
      "category": "command_injection",
      "description": "Downloading and executing remote scripts is extremely dangerous. Used in 2018 xeactor attack.",
      "recommendation": "Download scripts first, review them, then execute",
      "cwe": "CWE-94",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "DLE-002",
      "name": "Wget pipe to shell",
      "severity": "critical",
      "category": "command_injection",
      "description": "Downloading and executing remote scripts via wget",
      "recommendation": "Download scripts first, review them, then execute",
      "cwe": "CWE-94",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "DLE-003",
      "name": "Curl output executed",
      "severity": "critical",
      "category": "command_injection",
      "description": "Curl output saved and executed - common malware pattern",
      "recommendation": "Review downloaded scripts before execution",
      "cwe": "CWE-94",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "ENV-001",
      "name": "LD_PRELOAD manipulation",
      "severity": "critical",
      "category": "malicious_code",
      "description": "LD_PRELOAD can be used to inject malicious libraries",
      "recommendation": "LD_PRELOAD manipulation is extremely suspicious",
      "cwe": "CWE-426",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "ENV-002",
      "name": "PATH manipulation",
      "severity": "high",
      "category": "malicious_code",
      "description": "Modifying PATH to hijack commands",
      "recommendation": "PATH manipulation in install scripts is suspicious",
      "cwe": "CWE-426",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "ENV-003",
      "name": "Shell startup file modification",
      "severity": "critical",
      "category": "persistence",
      "description": "Modifying shell config for persistence (bashrc, zshrc, fish, profile.d)",
      "recommendation": "Packages should not modify shell configuration",
      "cwe": "CWE-506",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "ESCAPE-001",
      "name": "Extraction or copy outside the build root",
      "severity": "critical",
      "category": "privilege_escalation",
      "description": "An archive is extracted, or files are copied, to an absolute system path instead of $srcdir/$pkgdir. A build runs as your user and must only ever write inside its own directories; writing to / or /usr or /etc during build() installs files that no package owns and that pacman will never remove.",
      "recommendation": "Extract and install into $srcdir and $pkgdir only. makepkg copies $pkgdir into the package; anything written elsewhere during a build is invisible to pacman.",
      "cwe": "CWE-22",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "EXEC-002",
      "name": "Shell -c command substitution fetch",
      "severity": "critical",
      "category": "malicious_code",
      "description": "sh -c \"$(curl ...)\" — fetches and runs remote code without an explicit pipe, evading the curl|sh rules.",
      "recommendation": "Do not build. This runs code fetched from a URL.",
      "cwe": "CWE-494",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "EXEC-005",
      "name": "Detached background execution",
      "severity": "medium",
      "category": "malicious_code",
      "description": "Launches a fetched/dropped payload detached from the build (setsid/nohup), so it keeps running after install.",
      "recommendation": "Review the detached process; this outlives the install.",
      "cwe": "CWE-506",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "EXEC-006",
      "name": "sqlite3 shell-command execution",
      "severity": "high",
      "category": "malicious_code",
      "description": "sqlite3's `.shell`/`.system` dot-commands run an arbitrary shell command, and `.import` can read an attacker-controlled file — an exec/RCE vector hidden inside what looks like a database call. Legitimate packages do not drive sqlite3 through these meta-commands.",
      "recommendation": "Do not build. sqlite3 .shell/.system run arbitrary commands; report the package.",
      "cwe": "CWE-94",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "EXEC-007",
      "name": "make reads a Makefile from stdin",
      "severity": "high",
      "category": "command_injection",
      "description": "`make -f -` / `make -f /dev/stdin` executes a Makefile fed on standard input (commonly the tail of a `curl ... | make -f -` fetch-and-run). A Makefile is arbitrary shell recipes, so this is RCE from an unverified source. Normal `make` / `make -f Makefile` builds are unaffected.",
      "recommendation": "Review the Makefile source; building a Makefile read from stdin/a pipe runs unverified recipes.",
      "cwe": "CWE-94",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "EXEC-REMOTE",
      "name": "Fetches and runs external code",
      "severity": "critical",
      "category": "malicious_code",
      "description": "The package downloads and executes code from an external URL at build/install time; the scanner does not follow it (opaque boundary).",
      "recommendation": "Do not build; obtain software that ships its real code.",
      "cwe": "CWE-494",
      "owner": "remote_exec",
      "pattern_based": false
    },
    {
      "id": "EXFIL-001",
      "name": "Curl POST data exfiltration",
      "severity": "critical",
      "category": "data_exfiltration",
      "description": "Sending data to external servers via curl POST",
      "recommendation": "Build/install should not send data externally",
      "cwe": "CWE-200",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "EXFIL-002",
      "name": "Netcat data transfer",
