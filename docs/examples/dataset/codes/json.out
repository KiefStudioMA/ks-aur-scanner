      "name": "SSH authorized_keys modified",
      "severity": "critical",
      "category": "persistence",
      "description": "Writes, appends to, copies over or installs an ssh authorized_keys file outside $pkgdir, or copies a directory tree into a live ~/.ssh. Adding a key to a user's or root's authorized_keys is a persistent backdoor: the key's owner can log in after the package is gone.",
      "recommendation": "Do NOT install. A package must never touch authorized_keys. Remove any unknown keys from ~/.ssh/authorized_keys and /root/.ssh/authorized_keys and treat the host as compromised.",
      "cwe": "CWE-506",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "PERSIST-008",
      "name": "AI coding assistant config or hook written",
      "severity": "critical",
      "category": "persistence",
      "description": "Writes into an AI coding assistant's per-user configuration (Claude Code, Cursor, Codex, Gemini CLI, OpenCode, Continue, Aider, Copilot) outside $pkgdir. Settings, hooks and MCP definitions there run commands with the user's authority whenever the assistant starts, which supply-chain malware has used for persistence.",
      "recommendation": "Do NOT install. A package must never write into a user's assistant configuration. Inspect ~/.claude, ~/.cursor, ~/.codex, ~/.gemini and ~/.config/opencode for hooks or MCP servers you did not add.",
      "cwe": "CWE-506",
      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "PERSIST-009",
      "name": "pacman hook written outside $pkgdir",
      "severity": "critical",
      "category": "persistence",
      "description": "Writes a libalpm hook into /etc/pacman.d/hooks/ or /usr/share/libalpm/hooks/ directly instead of shipping it in the package. A hook runs as root on pacman transactions, so a hook planted by a scriptlet or build function is a root persistence mechanism.",
      "recommendation": "Do NOT install. Hooks belong in the package file list under $pkgdir, where pacman owns and can remove them.",
      "cwe": "CWE-506",
      "owner": "rules",
      "pattern_based": true
    },
    {
