      "cwe": "CWE-22",
      "owner": "scanner",
      "pattern_based": false
    },
    {
      "id": "SCAN-004",
      "name": "Archive uses structures where tar readers disagree",
      "severity": "high",
      "category": "configuration",
      "description": "A local tar archive uses structures outside the plain ustar/GNU subset (unknown type flags, pax global headers or unusual keys, non-octal numbers, directory-named files with data, data on links, duplicate names, bytes after the end marker). Tar readers extract different files from such an archive, so what makepkg unpacks may differ from what was reviewed.",
      "recommendation": "Do not install. Re-create the archive with plain tar, or ship the files directly.",
      "cwe": "CWE-436",
      "owner": "scanner",
      "pattern_based": false
