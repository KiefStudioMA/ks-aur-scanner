      "owner": "rules",
      "pattern_based": true
    },
    {
      "id": "OBF-012",
      "name": "Message function redefined to execute its arguments",
      "severity": "critical",
      "category": "obfuscation",
      "description": "A function or alias named like a message printer (echo, printf, msg, note, warning, plain, error ...) is redefined so that it runs what it is given (\"$@\", eval, sh -c, a pipe to a shell). Scanners and reviewers treat those names as harmless text, so every call that looks like a status message becomes a command. Calls to a redefined printer are analyzed as code, and the name stops being treated as inert everywhere in the package.",
      "recommendation": "Do not install. A legitimate package has no reason to make a message helper execute its arguments.",
      "cwe": "CWE-94",
      "owner": "deep",
      "pattern_based": false
    },
    {
      "id": "OBF-020",
      "name": "Dynamic command name",
      "severity": "high",
      "category": "obfuscation",
      "description": "The command word is an expansion the scanner cannot resolve (${x:1:3}, ${x//a/b}, ${x#p}, ${a[1]}, $(echo ... | tr ...), \"$1\") on a line that fetches a URL into a shell, or in front of a package-manager verb (install, add, i). Hiding the command name this way is how a payload dodges name-based rules; ordinary build lines such as ${CC:-gcc} or \"${CMAKE[@]}\" are not matched.",
      "recommendation": "Review the line; the command being run is assembled at run time to avoid matching.",
      "cwe": "CWE-94",
      "owner": "rules",
      "pattern_based": true
    },
