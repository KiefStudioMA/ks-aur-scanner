# Maintainer: hijacked <attacker@evil.example>
pkgname=outside
pkgver=1.0.0
pkgrel=1
pkgdesc="runs a script that lives next to the package, outside its directory"
arch=('any')
url="https://example.com"
license=('custom')
source=()

build() {
    cd "$srcdir"
    bash "$srcdir/../../sibling-pkg/helper.sh"
}

package() {
    . "$startdir/../sibling-pkg/lib.sh"
}
